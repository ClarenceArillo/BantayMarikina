[debug] [2026-05-17T16:50:10.337Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/marikina-hazard-system/rulesets {"name":"projects/marikina-hazard-system/rulesets/e3af1ba1-41d1-4c7f-89b0-af116286d815","source":{"files":[{"content":"rules_version = '2';\r\n\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    function signedIn() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    function validMarikinaPoint() {\r\n      return request.resource.data.latitude is number\r\n        && request.resource.data.longitude is number\r\n        && request.resource.data.latitude >= 14.57\r\n        && request.resource.data.latitude <= 14.72\r\n        && request.resource.data.longitude >= 121.03\r\n        && request.resource.data.longitude <= 121.18;\r\n    }\r\n\r\n    function validHazardReport() {\r\n      return request.resource.data.hazardType in [\r\n          'Flood',\r\n          'Fire',\r\n          'Landslide',\r\n          'Earthquake Damage',\r\n          'Road Blockage',\r\n          'Power Outage',\r\n          'Others'\r\n        ]\r\n        && request.resource.data.description is string\r\n        && request.resource.data.description.size() >= 8\r\n        && request.resource.data.description.size() <= 240\r\n        && request.resource.data.severity in ['Low', 'Moderate', 'High', 'Critical']\r\n        && request.resource.data.status in ['active', 'pending']\r\n        && validMarikinaPoint();\r\n    }\r\n\r\n    match /Reports/{reportId} {\n      allow read: if signedIn();\n      allow create: if signedIn()\n        && request.resource.data.userId == request.auth.uid\r\n        && validHazardReport();\r\n      allow update: if signedIn()\r\n        && resource.data.userId == request.auth.uid\r\n        && request.resource.data.diff(resource.data).changedKeys().hasOnly([\r\n          'description',\r\n          'imageUrl',\r\n          'image_url',\r\n          'updatedAt'\r\n        ]);\r\n      allow delete: if false;\n    }\n\n    match /DashboardData/{docId} {\n      allow read: if docId in ['weather', 'waterlevel'];\n      allow write: if false;\n\n      match /records/{recordId} {\n        allow read: if docId in ['weather', 'waterlevel'];\n        allow write: if false;\n      }\n    }\n\n    match /Users/{userId} {\n      allow read, update: if signedIn() && request.auth.uid == userId;\n      allow create: if false;\n    }\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2026-05-17T16:50:10.578879Z","metadata":{"services":["cloud.firestore"]}}
