rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validMarikinaPoint() {
      return request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.latitude >= 14.57
        && request.resource.data.latitude <= 14.72
        && request.resource.data.longitude >= 121.03
        && request.resource.data.longitude <= 121.18;
    }

    function validHazardReport() {
      return request.resource.data.hazardType in [
          'Flood',
          'Fire',
          'Landslide',
          'Earthquake Damage',
          'Road Blockage',
          'Power Outage',
          'Others'
        ]
        && request.resource.data.description is string
        && request.resource.data.description.size() >= 8
        && request.resource.data.description.size() <= 240
        && request.resource.data.severity in ['Low', 'Moderate', 'High', 'Critical']
        && request.resource.data.status in ['active', 'pending']
        && validMarikinaPoint();
    }

    match /Reports/{reportId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && validHazardReport();
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'description',
          'imageUrl',
          'image_url',
          'updatedAt'
        ]);
      allow delete: if false;
    }

    match /DashboardData/{docId} {
      allow read: if docId in ['weather', 'waterlevel'];
      allow write: if false;

      match /records/{recordId} {
        allow read: if docId in ['weather', 'waterlevel'];
        allow write: if false;
      }
    }

    match /Users/{userId} {
      allow read, update: if signedIn() && request.auth.uid == userId;
      allow create: if false;
    }
  }
}
